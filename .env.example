# ─────────────────────────────────────────────────────────────────────────────
# Core Grid Africa — environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/core_grid_africa

# Long random string used to sign session cookies.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# ── Paystack (payments) ──────────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developers
# Server-side verification uses the SECRET key only — never expose it to the client.
# Until all three are set, online payments stay disabled by design.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the deployed app (used for the Paystack callback/redirect).
APP_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────
# Enables prose answers in the AI Business Advisor.
# Without it the advisor still works using its built-in rules engine.
OPENAI_API_KEY=
OPENAI_MODEL=

SUPPORT_EMAIL=support@coregridafrica.com

PORT=3001
NODE_ENV=development

# ── Platform-injected (do NOT set these yourself on the Teamily platform) ────
# DB_DRIVER=tcp                 # "tcp" (default) or "http" (Neon serverless)
# DB_POOL_MAX=5
# AUTH_PROVIDER=local           # "local" (email/password) or "none"
# APP_SLUG=core-grid-africa
# APP_STORAGE_PRESIGN_URL=
# APP_STORAGE_TOKEN=
