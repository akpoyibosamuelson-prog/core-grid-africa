# ─────────────────────────────────────────────────────────────────────────────
# Core Grid Africa — environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Platform-injected (do NOT set these yourself on the Teamily platform) ─────
# DATABASE_URL=postgres://user:password@host:5432/core_grid_africa
# DB_DRIVER=tcp                 # "tcp" (default) or "http" (Neon serverless)
# DB_POOL_MAX=5
# JWT_SECRET=change-me-to-a-long-random-string
# AUTH_PROVIDER=local           # "local" (email/password) or "none"
# APP_SLUG=core-grid-africa
# APP_STORAGE_PRESIGN_URL=
# APP_STORAGE_TOKEN=
# NODE_ENV=development
# PORT=3000

# ── Paystack (payments) ───────────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developers
# Server-side verification uses the SECRET key only — never expose it to the client.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the deployed app (used for Paystack callback/redirect).
APP_URL=http://localhost:3000

# ── Support ───────────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@coregridafrica.com
